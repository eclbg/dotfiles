### Mirrored from kitty/kitty.conf and kitty/current-theme.conf ###

macos-option-as-alt = left
# Mirror Kitty's `hide_window_decorations titlebar-only`.
macos-titlebar-style = hidden

# Keep Ctrl+I distinct from Tab in terminal apps.
keybind = ctrl+i=text:\x1b[105;5u

# Match Kitty's current-window font scaling shortcuts (+/- 2pt).
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1

# Use Ghostty's built-in Catppuccin theme.
theme = Catppuccin Latte
